# Keys to set in the remote cip.env (/home/deploy/.config/cloudpilot/env/cip.env).
# No secrets here. Remove/override the existing MiniMax/DeepSeek LLM_* keys.
LLM_PROVIDER=local
LLM_MODEL=cip-llm
LLM_BASE_URL=http://ollama:11434/v1
LLM_CONTEXT_SIZE=4096
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_S=90
LLM_FIRST_TOKEN_TIMEOUT_S=30
LLM_MAX_RETRIES=0
LLM_CONTEXT_TOP_K=4
LLM_CONTEXT_CHUNK_CHARS=1200
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.50
# Rollback: LLM_PROVIDER=extractive (no LLM calls; Ollama can then be stopped).
