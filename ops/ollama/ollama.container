# Ollama (rootless Podman Quadlet) - internal LLM server for CIP.
# Internal only: NO PublishPort, no public route. cip-api reaches it at
# http://ollama:11434/v1 on cip-llm.network (dedicated network; NOT cloudpilot.network,
# so CloudPilot containers cannot reach this unauthenticated server).
#
# OPEN POINT (user decision): the CPU/memory limits below are placeholders.
# Replace @CPUS@ / @MEMORY@ before installing (see README.md, "Render the unit").
# The VPS is shared with CloudPilot (12 vCPU, ~28 GB available, load avg ~5-6, no GPU).
# Unrendered placeholders make `podman run` fail on purpose (fail-safe: no unlimited run).
[Unit]
Description=Ollama (internal LLM server for CIP)
After=cloudpilot-network.service

[Container]
Image=docker.io/ollama/ollama:0.40.18
ContainerName=ollama
Network=cip-llm.network
Volume=ollama-models.volume:/root/.ollama:U
Environment=OLLAMA_HOST=0.0.0.0:11434
Environment=OLLAMA_KEEP_ALIVE=24h
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_CONTEXT_LENGTH=4096
# Resource limits (overridable, OPEN POINT). Needs cgroup v2 cpu+memory delegated to
# the rootless user, otherwise podman ignores them (check in README).
PodmanArgs=--cpus=@CPUS@ --memory=@MEMORY@
NoNewPrivileges=true
HealthCmd=ollama list
HealthInterval=30s
HealthRetries=5
HealthStartPeriod=60s
HealthTimeout=10s

[Service]
Restart=always
RestartSec=10
# First start pulls the image.
TimeoutStartSec=900

[Install]
WantedBy=default.target
