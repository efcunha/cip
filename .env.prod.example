# ─────────────────────────────────────────────────────────────────────────
# CIP — deploy SELF-CONTAINED (open-source)
# COPIE para `.env.prod` e preencha. NUNCA commite `.env.prod` (está no
# .gitignore). Valores abaixo são PLACEHOLDERS — troque antes de subir.
#
#   cp .env.prod.example .env.prod
# ─────────────────────────────────────────────────────────────────────────

# ─── Database (PostgreSQL próprio do CIP — OBRIGATÓRIO em produção) ───────
# POSTGRES_PASSWORD é OBRIGATÓRIA: o docker-compose.prod.yml falha o boot
# (readiness) se não estiver definida. Use um gerador de senha forte.
POSTGRES_USER=cip
POSTGRES_PASSWORD=
POSTGRES_DB=cip

# ─── LLM (OBRIGATÓRIO) ────────────────────────────────────────────────────
# Provider: minimax | deepseek | bedrock | openai | local | stub
LLM_PROVIDER=minimax
LLM_MODEL=MiniMax-M3
LLM_BASE_URL=https://api.minimax.io/v1
LLM_CONTEXT_SIZE=1000000
LLM_MAX_TOKENS=131072
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# Credencial — DEFINA EXATAMENTE UMA (conforme LLM_PROVIDER):
#   minimax  -> LLM_API_KEY (sk-cp-...) ou MINIMAX_API_KEY
#   deepseek -> LLM_API_KEY (sk-...)      ou DEEPSEEK_API_KEY
#   openai   -> LLM_API_KEY
#   bedrock  -> usa credenciais AWS (abaixo)
LLM_API_KEY=


# MINIMAX_API_KEY=


# DEEPSEEK_API_KEY=


# ─── Embeddings (OBRIGATÓRIO — deve casar com o modelo/dimensão) ──────────
# Default = local + intfloat/multilingual-e5-small (dim 384), que é o que o
# `db/schema.sql` cria (`vector(384)`). Embeddings rodam LOCAL em CPU (zero
# custo financeiro no ingest). Trocar modelo exige re-ingestão completa.
EMBED_PROVIDER=local
EMBED_MODEL=intfloat/multilingual-e5-small
EMBED_DIM=384
EMBED_DEVICE=cpu
EMBED_QUERY_INSTRUCTION=query:
EMBED_TEXT_INSTRUCTION=passage:

# ─── Retrieval ────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.80

# ─── App ──────────────────────────────────────────────────────────────────
CIP_ENV=production
CIP_READONLY=true
LOG_LEVEL=INFO

# ─── Auth multi-tenant (OBRIGATÓRIO em produção) ──────────────────────────
# Formato: "chave:tenant:rpm,chave2:tenant2:rpm" (rpm = requests/minuto).
# Sem esta var em CIP_ENV=production, /ask e /analyze respondem 401.
CIP_API_KEYS=

# ─── Concorrência / robustez (opcional, com default no compose) ───────────
MAX_CONCURRENT_REQUESTS=200
REQUEST_TIMEOUT_S=90
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20

# ─── AWS (tools read-only — opcional; credenciais temporárias STS) ────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ─── Azure (opcional) ─────────────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ─── GCP (opcional) ───────────────────────────────────────────────────────
GCP_PROJECT_ID=

# ─── JWT (opcional) ───────────────────────────────────────────────────────
JWT_SECRET=
JWT_ALGORITHM=HS256
