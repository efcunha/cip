# ─── Banco de dados (pgvector) ────────────────────────────────────────────
DATABASE_URL=postgresql://cip:cip@localhost:5432/cip
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cip
DB_USER=cip
DB_PASSWORD=cip

# ─── LLM ──────────────────────────────────────────────────────────────────
# Provider: bedrock | openai | local | minimax | deepseek | stub | extractive
#   bedrock    — AWS Bedrock (Claude Sonnet 4.5)
#   openai     — OpenAI API (GPT-4o, etc)
#   local      — Self-hosted OpenAI-compatible (vLLM, Ollama) — AINDA usa LLM (servidor local)
#   minimax    — MiniMax M3 via OpenAI-compatible API
#   deepseek   — DeepSeek-V4-Flash via OpenAI-compatible API (fallback do MiniMax)
#   stub       — Mock (dev/test, sem credenciais)
#   extractive — SÍNTESE EXTRATIVA LOCAL: NENHUM LLM (cita trechos recuperados
#                via embedding local). Único modo que satisfaz "sem modelo externo".
LLM_PROVIDER=extractive
LLM_MODEL=extractive
LLM_CONTEXT_SIZE=200000
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048          # teto de saida (default do SDK e 512 = trunca)
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2            # baixo: evita retry storm sob carga

# OpenAI-compatible providers (openai | local | minimax | deepseek):
LLM_API_KEY=                 # API key (sk-cp-... para MiniMax | sk-... para DeepSeek)
LLM_BASE_URL=                 # Custom base URL
                              #   MiniMax padrao: https://api.minimax.io/v1
                              #   DeepSeek padrao: https://api.deepseek.com/v1
                              #   OpenAI padrao:   https://api.openai.com/v1
                              #   local/vLLM:      http://localhost:8001/v1
#   local/Ollama:    http://ollama:11434/v1  (LLM_PROVIDER=local; ver ops/ollama/)

# Exemplo Ollama (LLM local, so responde com o contexto do RAG; cai em extractive se falhar):
# LLM_PROVIDER=local
# LLM_MODEL=cip-llm
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_CONTEXT_SIZE=4096
# LLM_MAX_TOKENS=512
# LLM_TIMEOUT_S=90
# LLM_FIRST_TOKEN_TIMEOUT_S=30
# LLM_MAX_RETRIES=0
# LLM_CONTEXT_TOP_K=5          # chunks enviados ao LLM (eval DeepInfra: 5 > 4, ver CHANGELOG)
# LLM_CONTEXT_CHUNK_CHARS=1200
# Query translation PT-BR -> EN antes do retrieval (embedding e so ingles). So com LLM real.
# QUERY_TRANSLATION_ENABLED=true
# QUERY_TRANSLATION_TIMEOUT_S=5     # falha/timeout => usa a pergunta original
# QUERY_TRANSLATION_CACHE_TTL_S=86400
# Exemplo MiniMax M3 (provider oficial):
# LLM_PROVIDER=minimax
# LLM_MODEL=MiniMax-M3
# LLM_API_KEY=sk-cp-SEU-TOKEN-AQUI
# LLM_BASE_URL=https://api.minimax.io/v1
# LLM_CONTEXT_SIZE=1000000     # MiniMax M3 suporta ate 1M tokens de contexto
# LLM_MAX_TOKENS=131072       # e ate 131k tokens de saida

# Fallback DeepSeek-V4-Flash (caso o MiniMax M3 esteja indisponível):
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-v4-flash
# LLM_API_KEY=sk-SEU-TOKEN-AQUI
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1   (opcional; já é o default)

# O provider tambem aceita MINIMAX_API_KEY e DEEPSEEK_API_KEY como
# variáveis canônicas de credencial (alias dos respectivos providers).

# ─── Concorrencia / robustez ──────────────────────────────────────────────
MAX_CONCURRENT_REQUESTS=200  # acima disso -> HTTP 429 (backpressure)
REQUEST_TIMEOUT_S=90         # timeout total por request -> HTTP 504
DB_POOL_SIZE=20              # dimensione ~ concorrencia por worker
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_S=30
DB_POOL_RECYCLE_S=1800

# ─── Embeddings ───────────────────────────────────────────────────────────
# Perfil integrado (padrão): bge-large-en-v1.5, casado com docker-compose.yml.
# Provider: local | bedrock | openai   (bedrock/openai = sem ML local, via API)
EMBED_PROVIDER=local
EMBED_MODEL=BAAI/bge-large-en-v1.5
EMBED_DIM=1024             # bge-large=1024 | e5-small=384 | Titan=1024 | OpenAI 3-small=1536
EMBED_DEVICE=cpu           # cpu | cuda
EMBED_QUERY_INSTRUCTION=query:     # prefixo p/ E5/BGE (vazio p/ desativar)
EMBED_TEXT_INSTRUCTION=passage:

# ─── Retrieval ────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=8
# Atrelado ao modelo de embeddings (única fonte de verdade — casar com o client):
#   bge-large-en-v1.5 (1024 dims, integrado) -> 0.50 (calibração real Round 25:
#       grounded ~0.57-0.81, off-topic ~0.49; o antigo 0.35 admitia off-topic)
#   e5-small (384 dims) -> 0.80
RETRIEVAL_MIN_SCORE=0.50

# ─── AWS (tools read-only) ────────────────────────────────────────────────
# Use credenciais TEMPORÁRIAS (STS). Nunca chaves de longo prazo em prod.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ─── Azure (tools read-only) ──────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ─── GCP (tools read-only) ────────────────────────────────────────────────
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-readonly-sa.json

# ─── Observabilidade (opcional) ───────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ─── App ──────────────────────────────────────────────────────────────────
# Para auth estrita (401 sem key / 403 mismatch de tenant), use CIP_ENV != dev.
CIP_ENV=production
CIP_READONLY=true           # trava global: nunca permite ações de escrita
LOG_LEVEL=INFO
# Mapa de API keys -> tenant (formato "key:tenant:rpm", separado por vírgula).
# Ausência de key em produção => 401. Nunca commitar valores reais.
CIP_API_KEYS=


